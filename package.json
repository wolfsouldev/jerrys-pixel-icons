{
  "name": "jerrys-pixel-icons",
  "displayName": "Jerry's Pixel Icons",
  "description": "Un tema de iconos pixel art personalizado para VS Code",
  "publisher": "MelissaGutierrez",
  "version": "0.3.0",
  "packageManager": "pnpm@12.15.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/wolfsouldev/jerrys-pixel-icons.git"
  },
  "icon": "./assets/logo.png",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "iconThemes": [
      {
        "id": "jerrys-pixel",
        "label": "Jerry's Pixel",
        "path": "./themes/icon-theme.json"
      }
    ]
  },
  "scripts": {
    "generate": "node scripts/generate-theme.mjs",
    "generate:check": "node scripts/generate-theme.mjs --check",
    "validate": "pnpm run generate:check && node scripts/validate-theme.mjs",
    "lint": "eslint scripts gallery",
    "pretest": "pnpm run lint && pnpm run validate",
    "test": "node --test scripts/*.test.mjs",
    "vscode:prepublish": "pnpm test",
    "package": "vsce package --no-dependencies && pnpm run package:check",
    "package:check": "node scripts/check-package.mjs",
    "gallery:build": "node scripts/build-gallery.mjs",
    "gallery:preview": "pnpm run gallery:build && node scripts/serve-gallery.mjs",
    "gallery:verify": "node scripts/check-live-gallery.mjs",
    "test:gallery": "playwright test --config gallery/playwright.config.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.105.0",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.0",
    "eslint": "^9.36.0",
    "fast-xml-parser": "^5.11.2",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1",
    "yauzl": "^3.4.0"
  }
}
