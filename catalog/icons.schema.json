{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jerry's Pixel Icons source catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "defaults", "files", "folders"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "folder"],
      "properties": {
        "file": { "$ref": "#/$defs/id" },
        "folder": { "$ref": "#/$defs/id" }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "icon": { "$ref": "#/$defs/icon" },
          "label": { "type": "string", "pattern": "\\S" },
          "tags": { "$ref": "#/$defs/tags" },
          "extensions": { "$ref": "#/$defs/aliases" },
          "names": { "$ref": "#/$defs/aliases" }
        }
      }
    },
    "folders": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "icon": { "$ref": "#/$defs/icon" },
          "expandedId": { "$ref": "#/$defs/id" },
          "label": { "type": "string", "pattern": "\\S" },
          "tags": { "$ref": "#/$defs/tags" },
          "names": { "$ref": "#/$defs/aliases" }
        }
      }
    }
  },
  "$defs": {
    "tags": {
      "type": "array",
      "items": { "type": "string", "pattern": "\\S" }
    },
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" },
    "icon": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "pattern": "^[^*?]+$" }
    }
  }
}
